---
interface Props {
  src?: string;
  webpSources?: Array<{ src: string; width: number }>;
  sizes?: string;
  alt: string;
  label: string;
  width?: number;
  height?: number;
  eager?: boolean;
  class?: string;
}

const {
  src,
  webpSources = [],
  sizes = '100vw',
  alt,
  label,
  width = 1600,
  height = 1000,
  eager = false,
  class: className = '',
} = Astro.props;

const imagePath = src ? `${import.meta.env.BASE_URL}${src.replace(/^\//, '')}` : undefined;
const webpSrcset = webpSources.map(({ src, width }) => `${import.meta.env.BASE_URL}${src.replace(/^\//, '')} ${width}w`).join(', ');
---

<figure class:list={['product-image', className]} style={`--ratio:${width}/${height}`}>
  <div class="product-image__surface">
    <span class="product-image__placeholder" aria-hidden="true">
      <span>IMAGE</span>
      <small>{label}</small>
    </span>
    {imagePath && (
      <picture>
        {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
        <img
          src={imagePath}
          alt={alt}
          width={width}
          height={height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          onerror="this.hidden=true"
        />
      </picture>
    )}
  </div>
  <figcaption>{label}</figcaption>
</figure>

<style>
  .product-image { margin: 0; }
  .product-image__surface { position: relative; aspect-ratio: var(--ratio); overflow: hidden; background: #deddd8; }
  .product-image__placeholder { position: absolute; inset: 0; display: grid; place-content: center; gap: .7rem; color: #888680; text-align: center; }
  .product-image__placeholder span { font-size: .62rem; letter-spacing: .18em; }
  .product-image__placeholder small { font-size: .58rem; letter-spacing: .1em; }
  picture { display: contents; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: .7rem; color: #77756f; font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; }
</style>
