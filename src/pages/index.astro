---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductImage from '../components/ProductImage.astro';

const specs = [
  ['Layout', '44-key ortholinear'], ['Key pitch', '17 mm'], ['Size', '130.7 × 77.7 mm'],
  ['Thickness', '6.5 mm'], ['Weight', 'Approx. 221 g / pair'],
  ['Connectivity', 'Bluetooth / Wireless'], ['Firmware', 'ZMK'], ['Power', 'AAA battery × 1 / side'], ['MCU', 'XIAO nRF52840'],
];
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Nickey44A トップへ">Nickey44A</a>
    <nav aria-label="メインナビゲーション"><a href="#gallery">Gallery</a><a href="#products">Buy</a><a href="#specs">Specs</a></nav>
  </header>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow">WIRELESS SPLIT KEYBOARD</p><h1 id="hero-title">Nickey<span>44A</span></h1><p class="hero-lead">HHKBの思想を、<br />無線分割キーボードへ。</p></div>
      <figure class="hero-media"><picture><source type="image/webp" srcset={`${import.meta.env.BASE_URL}images/hero-charcoal-900.webp 900w, ${import.meta.env.BASE_URL}images/hero-charcoal-1550.webp 1550w`} sizes="100vw" /><img src={`${import.meta.env.BASE_URL}images/hero-charcoal.png`} width="1550" height="1015" alt="黒いNickey44Aを左右に分けて配置した様子" fetchpriority="high" /></picture></figure>
    </section>

    <section class="aaa-section" aria-labelledby="aaa-title">
      <div class="aaa-copy section-intro section-pad"><p class="kicker">AAA POWERED</p><h2 id="aaa-title">左右それぞれ、<br />単4電池1本。</h2><p>必要最小限のサイズで、持ち運びも軽やかに。</p></div>
      <ProductImage src="images/aaa-powered-focus.png" webpSources={[{ src: 'images/aaa-powered-focus.webp', width: 1630 }]} sizes="100vw" alt="Nickey44Aの単4電池部分" label="AAA BATTERY" width={1630} height={965} class="aaa-image" />
    </section>

    <section class="layout-proportion" aria-labelledby="layout-title">
      <div class="layout-copy section-intro section-pad"><p class="kicker">LAYOUT / PROPORTION</p><h2 id="layout-title">修飾キーを、<br />無理なく押せる場所に。</h2><p>HHKBで培った修飾キー配置を活かせるよう、小指側は2列を確保。コンパクトさだけを追わず、CtrlやShiftを自然に置ける44キーにしています。</p></div>
      <ProductImage src="images/wireless.jpg" webpSources={[{ src: 'images/wireless-1200.webp', width: 1200 }, { src: 'images/wireless-2200.webp', width: 2200 }]} sizes="100vw" alt="Nickey44Aのキー配列" width={6186} height={3974} class="layout-image" />
    </section>

    <section class="thin-profile" aria-labelledby="thin-title">
      <div class="thin-copy section-intro section-pad"><p class="kicker">THIN PROFILE</p><h2 id="thin-title">リストレストから、<br />解放する。</h2><p>机との段差を抑え、手首を自然な位置へ。</p></div>
      <div class="thin-visual"><ProductImage src="images/thin-light.jpg" alt="横から見たNickey44Aの薄さ" label="THIN PROFILE / 6.5 MM" width={4096} height={2731} class="thin-image" /><p class="thin-number">6.5 <span>mm</span></p></div>
    </section>

    <section class="gallery section-pad" id="gallery" aria-labelledby="gallery-title">
      <div class="section-heading"><p class="kicker" id="gallery-title">GALLERY</p></div>
      <div class="gallery-grid">
        <ProductImage src="images/A7V09728.JPG" alt="Nickey44Aの薄い側面" label="SIDE PROFILE" width={1800} height={1200} class="gallery-side" />
      </div>
    </section>

    <section class="products section-pad" id="products" aria-labelledby="products-title">
      <div class="section-heading"><p class="kicker">PRODUCTS</p><h2 id="products-title">Choose yours.</h2></div>
      <div class="product-options"><article><h3>Build Kit</h3><p>自分の手で仕上げるためのキット。</p><a href="https://potamega.booth.pm/items/8744351">VIEW ON BOOTH <b>↗</b></a></article><article><h3>Fully Assembled</h3><p>すぐに使い始められる完成品。</p><a href="https://potamega.booth.pm/items/8744204">VIEW ON BOOTH <b>↗</b></a></article></div>
    </section>

    <section class="specifications section-pad" id="specs" aria-labelledby="specs-title">
      <div class="section-heading"><p class="kicker">SPECIFICATIONS</p><h2 id="specs-title">The essentials.</h2></div>
      <dl class="spec-list">{specs.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    </section>
  </main>
  <footer class="site-footer section-pad"><div><a class="footer-mark" href="#top">Nickey44A</a><p>Designed by Nix</p></div><nav aria-label="フッターナビゲーション"><a href="https://potamega.booth.pm/">BOOTH</a><a href="https://nixiy.github.io/nickey-docs/nickey44a/">BUILD GUIDE</a><a href="https://github.com/nixiy/nickey-site">GITHUB</a></nav><p class="copyright">© 2026 NICKEY44A</p></footer>
</BaseLayout>
