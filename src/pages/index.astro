---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductImage from '../components/ProductImage.astro';

const specs = [
  ['Layout', '44-key ortholinear'], ['Key pitch', '17 mm'], ['Size', '130.7 × 77.7 mm'],
  ['Thickness', '6.5 mm'], ['Weight', 'Approx. 221 g / pair'],
  ['Connectivity', 'Bluetooth / Wireless'], ['Firmware', 'ZMK'], ['Power', 'AAA battery × 1 / side'], ['MCU', 'XIAO nRF52840'],
];
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Nickey44A トップへ">Nickey44A</a>
    <nav aria-label="メインナビゲーション"><a href="#products">Buy</a><a href="#specs">Specs</a></nav>
  </header>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow">WIRELESS SPLIT KEYBOARD</p><h1 id="hero-title">Nickey<span>44A</span></h1><p class="hero-lead">コンパクトでも、<br />妥協しない。</p></div>
      <figure class="hero-media"><picture><source type="image/webp" srcset={`${import.meta.env.BASE_URL}images/hero-charcoal-900.webp 900w, ${import.meta.env.BASE_URL}images/hero-charcoal-1550.webp 1550w`} sizes="100vw" /><img src={`${import.meta.env.BASE_URL}images/hero-charcoal.png`} width="1550" height="1015" alt="黒いNickey44Aを左右に分けて配置した様子" fetchpriority="high" /></picture></figure>
    </section>

    <section class="aaa-section" aria-labelledby="aaa-title">
      <div class="aaa-copy section-intro section-pad"><p class="kicker">AAA POWERED</p><h2 id="aaa-title">左右それぞれ、<br />単4電池1本。</h2><p>必要最小限のサイズで、持ち運びも軽やかに。</p></div>
      <ProductImage src="images/aaa-battery-detail.jpg" webpSources={[{ src: 'images/aaa-battery-detail-900.webp', width: 900 }, { src: 'images/aaa-battery-detail-1920.webp', width: 1920 }]} sizes="100vw" alt="Nickey44Aに収まる単4形充電池のアップ" label="AAA BATTERY" width={1920} height={1280} class="aaa-image" />
    </section>

    <section class="layout-proportion" aria-labelledby="layout-title">
      <div class="layout-copy section-intro section-pad"><p class="kicker">LAYOUT / PROPORTION</p><h2 id="layout-title">修飾キーを、<br />無理なく押せる場所に。</h2><p>HHKBで培った修飾キー配置を活かせるよう、小指側は2列を確保。コンパクトさだけを追わず、CtrlやShiftを自然に置ける44キーにしています。</p></div>
      <ProductImage src="images/layout-left-hand.jpg" webpSources={[{ src: 'images/layout-left-hand-900.webp', width: 900 }, { src: 'images/layout-left-hand-1536.webp', width: 1536 }]} sizes="100vw" alt="CtrlやSpaceなどの修飾キーを配置したNickey44Aの左手側" width={1536} height={1024} class="layout-image" />
    </section>

    <section class="thin-profile" aria-labelledby="thin-title">
      <div class="thin-copy section-intro section-pad"><p class="kicker">THIN PROFILE</p><h2 id="thin-title">リストレストから、<br />解放する。</h2><p>本体厚は、ボトムプレート下面からトッププレート上面まで。最薄部で6.5 mm。<br />机との段差を抑え、手首を自然な位置へ。</p></div>
      <div class="thin-visual"><ProductImage src="images/thin-light-cropped.jpg" webpSources={[{ src: 'images/thin-light-1200.webp', width: 1200 }, { src: 'images/thin-light-2400.webp', width: 2400 }]} sizes="(max-width: 768px) 100vw, min(100vw, 1440px)" alt="横から見たNickey44Aの薄さ" label="THIN PROFILE / 6.5 MM" width={3800} height={2480} class="thin-image" /><p class="thin-number">6.5 <span>mm</span></p></div>
    </section>

    <section class="size-section" aria-labelledby="size-title">
      <div class="size-copy section-intro section-pad"><p class="kicker">SIZE</p><h2 id="size-title">必要な場所だけを、<br />手元に。</h2><p>片側 130.7 × 77.7 mm</p></div>
      <ProductImage src="images/A7V09750-cropped.jpg" webpSources={[{ src: 'images/size-comparison-1200.webp', width: 1200 }, { src: 'images/size-comparison-2400.webp', width: 2400 }]} sizes="(max-width: 768px) 100vw, min(100vw, 1440px)" alt="HHKB Professional HYBRID Type-Sの上に重ねたNickey44Aのサイズ比較" label="SIZE COMPARISON" width={5100} height={2320} class="size-image" />
    </section>

    <section class="products section-pad" id="products" aria-labelledby="products-title">
      <div class="section-heading section-intro"><p class="kicker">PRODUCTS</p><h2 id="products-title">あなただけの一台を。</h2><p>組み立てる楽しさを選ぶか、仕上がった一台を選ぶか。</p></div>
      <div class="product-options">
        <article><p class="product-type">BUILD YOUR OWN</p><h3>Build Kit</h3><ProductImage src="images/kit-contents.jpg" webpSources={[{ src: 'images/kit-contents-900.webp', width: 900 }, { src: 'images/kit-contents-1920.webp', width: 1920 }]} sizes="(max-width: 768px) 100vw, 50vw" alt="Nickey44A Build Kitに含まれる左右の基板、ケース、トッププレート、キースイッチソケット、電池端子、カバー、ネジ類" label="BUILD KIT / CONTENTS" width={1920} height={1280} class="product-card-image" /><p class="product-lead">自分の手で仕上げるNickey44A。</p><p class="product-note">一部パーツをPCBA実装済み。組み立てる時間まで楽しめます。</p><a href="https://potamega.booth.pm/items/8744351">BOOTHで見る <b>↗</b></a></article>
        <article><p class="product-type">READY TO CUSTOMIZE</p><h3>完成品</h3><ProductImage src="images/assembled-product.jpg" webpSources={[{ src: 'images/assembled-product-900.webp', width: 900 }, { src: 'images/assembled-product-1920.webp', width: 1920 }]} sizes="(max-width: 768px) 100vw, 50vw" alt="はんだ付けと組み立てが完了し、キースイッチとキーキャップを取り付ける前のNickey44A完成品" label="ASSEMBLED / READY TO CUSTOMIZE" width={1920} height={1280} class="product-card-image" /><p class="product-lead">面倒なところは、こちらで。</p><p class="product-note">はんだ付け・組み立て・Firmware書き込み・基本動作確認済み。スイッチとキーキャップで、最後は自分好みに。</p><a href="https://potamega.booth.pm/items/8744204">BOOTHで見る <b>↗</b></a></article>
      </div>
    </section>

    <section class="specifications section-pad" id="specs" aria-labelledby="specs-title">
      <div class="section-heading"><p class="kicker">SPECIFICATIONS</p></div>
      <dl class="spec-list">{specs.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    </section>
  </main>
  <footer class="site-footer section-pad"><div><a class="footer-mark" href="#top">Nickey44A</a><p>Designed by Nix</p></div><nav aria-label="フッターナビゲーション"><a href="https://potamega.booth.pm/">BOOTH</a><a href="https://nixiy.github.io/nickey-docs/nickey44a/">BUILD GUIDE</a><a href="https://github.com/nixiy/nickey-site">GITHUB</a></nav><p class="copyright">© 2026 NICKEY44A</p></footer>
</BaseLayout>
